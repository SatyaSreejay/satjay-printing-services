# Copy to .env.local for local development. Never commit real values.

# Public URL of the site, used in email links (no trailing slash).
SITE_URL=http://localhost:3000

# Long random string used to sign tracking/download links and admin sessions.
# Generate with: openssl rand -base64 32
APP_SECRET=change-me-to-a-long-random-string

# ---------- File and ticket storage ----------
# "local" stores uploads and tickets in ./.data (development only).
# "s3" uses any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2...).
STORAGE_DRIVER=local
# LOCAL_DATA_DIR=.data
S3_BUCKET=
S3_REGION=auto
# Leave empty for AWS; for R2 use https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Email (order tickets) ----------
# Works with Gmail: turn on 2-step verification, create an App Password,
# then use smtp.gmail.com, port 465, your Gmail address and the app password.
# Without these in development, emails are saved to .data/outbox/ instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender address (defaults to SMTP_USER).
MAIL_FROM=
# PLACEHOLDER: where new order tickets are sent (the shop owner's email).
SHOP_NOTIFY_EMAIL=shop-owner@example.com

# ---------- WhatsApp Business Cloud API (optional) ----------
# Leave empty to skip WhatsApp alerts (they are logged as skipped).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Shop owner's WhatsApp number, digits with country code, e.g. 919000000000
WHATSAPP_NOTIFY_TO=
# Approved template with 4 body variables: ticket, customer, service, link.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# ---------- Admin ----------
# Password for /admin (at least 8 characters). Admin is disabled when empty.
ADMIN_PASSWORD=
