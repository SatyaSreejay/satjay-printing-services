# Copy to .env.local for local development. Never commit real values.

# Public URL of the site, used in email links (no trailing slash).
SITE_URL=http://localhost:3000

# Long random string used to sign tracking/download links and admin sessions.
# Generate with: openssl rand -base64 32
APP_SECRET=change-me-to-a-long-random-string

# ---------- File and ticket storage ----------
# "local" stores uploads and tickets in ./.data (development only).
# "s3" uses any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2...).
STORAGE_DRIVER=local
# LOCAL_DATA_DIR=.data
S3_BUCKET=
S3_REGION=auto
# Leave empty for AWS; for R2 use https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Email (order tickets) ----------
# Works with Gmail: turn on 2-step verification, create an App Password,
# then use smtp.gmail.com, port 465, your Gmail address and the app password.
# Without these in development, emails are saved to .data/outbox/ instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender address (defaults to SMTP_USER).
MAIL_FROM=
# Where new order tickets are sent.
SHOP_NOTIFY_EMAIL=bestbards@gmail.com

# ---------- WhatsApp Business Cloud API (optional) ----------
# Leave empty to skip WhatsApp alerts (they are logged as skipped).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Number that receives WhatsApp ticket alerts, digits with country code.
WHATSAPP_NOTIFY_TO=918790603022
# Approved template with 4 body variables: ticket, customer, service, link.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# ---------- Admin ----------
# Password for /admin (at least 8 characters). Admin is disabled when empty.
ADMIN_PASSWORD=

# ---------- AI (off by default; nothing calls an AI API until enabled) ----------
# Design assistant chat, powered by Claude.
AI_ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
# AI_CHAT_MODEL=claude-opus-5-5
# Text-free background artwork: "none" (off) or "gemini".
AI_IMAGE_PROVIDER=none
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Limits (per visitor IP, plus a site-wide daily total).
AI_CHAT_PER_IP_HOUR=20
AI_CHAT_PER_IP_DAY=60
AI_CHAT_DAILY_TOTAL=500
AI_IMAGE_PER_IP_DAY=5
AI_IMAGE_DAILY_TOTAL=50
